<IfModule mod_rewrite.c>

  RewriteEngine On
  RewriteBase /

  # Use PHP as the website entry point
  DirectoryIndex index.php

  # Keep existing files working
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Keep existing directories working
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Send all React routes to index.php
  RewriteRule ^ index.php [L]

</IfModule>